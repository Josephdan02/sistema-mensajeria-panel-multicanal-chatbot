APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CLINIC_API_URL=
CLINIC_API_KEY=
CLINIC_API_TIMEOUT=10

# mock usa MockAgendaService; api usa ApiAgendaService y requiere las variables CLINIC_API_*.
AGENDA_SERVICE=mock

# WhatsApp Cloud API (mock solo loguea; api envía de verdad a graph.facebook.com)
WHATSAPP_DRIVER=mock
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TIMEOUT=10

# Telegram Bot API
TELEGRAM_DRIVER=api
TELEGRAM_API_URL=https://api.telegram.org/bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT=10
TELEGRAM_WEBHOOK_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Adjuntos de los canales externos (Telegram) ---------------------------
# Almacenamiento privado de los archivos que envían los pacientes.
# El bucket DEBE ser privado: nunca se usa un bucket público ni public/storage.
#
# ATTACHMENTS_DRIVER: `supabase` (bucket privado de Supabase Storage) o
# `local` (disco `local` de Laravel, en storage/app/private, para desarrollo).
ATTACHMENTS_DRIVER=supabase

# URL del proyecto Supabase (sin barra final).
SUPABASE_URL=
# Clave de servidor de Supabase. NUNCA debe salir del backend: no se expone
# al navegador, ni en URLs, ni en logs ni en mensajes de error.
SUPABASE_SERVICE_ROLE_KEY=
# Nombre del bucket privado de los adjuntos.
SUPABASE_STORAGE_BUCKET=chatbot-attachments
# Duración (segundos) de las URLs firmadas de acceso al objeto.
SUPABASE_SIGNED_URL_TTL=120
# Tiempo máximo (segundos) de las peticiones al almacenamiento.
SUPABASE_TIMEOUT=30
